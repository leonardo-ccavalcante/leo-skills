# n8n skills pack — environment template
# Copy to .env (gitignored) and fill in. Never commit the real values.

# Your n8n instance base URL (no trailing slash)
N8N_API_URL=https://your-instance.app.n8n.cloud

# API key from n8n UI -> Settings -> n8n API.
# Treat as a ROOT credential on non-Enterprise plans; set an expiration at creation.
N8N_API_KEY=your_api_key_here

# Optional: backup-guard hook (n8n-pack/hooks/pre-tool-prod-guard.sh)
# Space-separated workflow IDs the hook protects from un-backed-up agent mutations.
#N8N_PROTECTED_WORKFLOW_IDS=abc123 def456
#N8N_BACKUP_DIR=./backups
#N8N_BACKUP_MAX_AGE_MIN=60
