{
  "_sobre": "Regras sobre o CORPO de request JSON aplicadas por `pcm.py lint` (spec pcm-spec.md, seção restricoes-api.json). Cada regra lista só os modelos que os fatos/páginas rastreados sustentam; `fatos` são os ids em pcm-build/facts; `exemplo_request` deve disparar a regra e `contra_exemplo_request` não. O que não é checável num corpo isolado está em `_lacunas`.",
  "regras": [
    {
      "id": "api.sampling_params",
      "modelos": [
        "opus-5-5",
        "opus-5",
        "opus-4-8",
        "opus-4-7",
        "sonnet-5",
        "fable-5-1",
        "fable-5"
      ],
      "checagem": {
        "tipo": "campo_presente",
        "campos": [
          "temperature",
          "top_p",
          "top_k"
        ]
      },
      "severidade": "hard",
      "motivo_pt": "temperature/top_p/top_k com valor não-default retornam 400 no Opus 4.7 e posteriores (inclusive Opus 5.5), no Sonnet 5 e no Fable 5.1/Fable 5; o valor default (ou omitir) é aceito, mas o lint não conhece o default e o caminho mais seguro, segundo o guia, é omitir. No Python SDK v1.0+ passá-los levanta TypeError.",
      "sugestao_pt": "remover temperature, top_p e top_k do corpo e guiar tom e variedade por instruções no system prompt (para variedade de design, pedir que o modelo proponha direções distintas antes de construir)",
      "fonte": {
        "page_id": "migration-guide-opus-5-5",
        "section": "Breaking changes"
      },
      "fontes_adicionais": [
        {
          "page_id": "migration-guide-opus-5-5",
          "section": "What every request to Claude Opus 5.5 must satisfy"
        },
        {
          "page_id": "whats-new-sonnet-5",
          "section": "Sampling parameters not accepted"
        },
        {
          "page_id": "whats-new-fable-5-1",
          "section": "Unchanged from Claude Fable 5"
        },
        {
          "page_id": "migration-guide-fable-5-1",
          "section": "Migrating to Claude Fable 5.1 from Claude Opus 5"
        }
      ],
      "fatos": [
        "opus-5-5.sampling_removed_sdk_typeerror",
        "opus-5-5.sampling_params_rejected",
        "sonnet-5.sampling_400",
        "fable-5-1.no_sampling_params"
      ],
      "exemplo_request": {
        "model": "x",
        "max_tokens": 1024,
        "messages": [
          {
            "role": "user",
            "content": "Oi"
          }
        ],
        "temperature": 0.7
      },
      "contra_exemplo_request": {
        "model": "x",
        "max_tokens": 1024,
        "messages": [
          {
            "role": "user",
            "content": "Oi"
          }
        ]
      }
    },
